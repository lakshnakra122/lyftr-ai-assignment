# Copy to .env and fill in real values. Real keys never go in the repo.
# Comma-separated LiteLLM key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-real-key-1,your-real-key-2
# LiteLLM model name
LLM_MODEL=gemini/gemini-2.0-flash
# SQLite location (Docker volume path in compose)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure failover test hook on the deployed backend
ENABLE_FAILURE_SIMULATION=true
# Frontend only: backend base URL baked in at build time
VITE_API_URL=http://localhost:8000
